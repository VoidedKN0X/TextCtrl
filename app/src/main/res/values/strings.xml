    <!-- First start -->
    <string name="setup_title">Make TextCtrl your SMS app</string>
    <string name="setup_body">Android only hands texts to one app, your SMS app. Once TextCtrl is that app, it gets every text and picture message straight from the mobile network.</string>
    <string name="setup_again_title">TextCtrl isn\'t your SMS app any more</string>
    <string name="setup_again_body">Another app was made your SMS app, so new texts go there. Make TextCtrl your SMS app again to keep using it.</string>
    <string name="setup_point_instant">Texts arrive the moment your phone receives them, with no push service in between.</string>
    <string name="setup_point_offline">No Google, no servers, no internet access at all. Your texts never leave your phone except to the people you send them to.</string>
    <string name="setup_make_default">Make it my SMS app</string>
    <string name="setup_no_sms">This device can\'t send or receive texts.</string>
    <string name="setup_declined">TextCtrl wasn\'t made your SMS app. Tap the button and choose TextCtrl to continue.</string>
    <string name="setup_permissions_title">A few more things</string>
    <string name="setup_permissions_body">All optional, all on your phone only. You can change them later in Android\'s settings.</string>
    <string name="setup_point_contacts">Contacts, to show names and pictures instead of numbers.</string>
    <string name="setup_point_notifications">Notifications, to tell you about new messages.</string>
    <string name="setup_point_sim">Phone, to pick a SIM for each chat and know your own number.</string>
